# Server
PORT=3009
NODE_ENV=development

# Data Source Identity
# Unique identifier for this data source (from PCM registration)
DATA_SOURCE_ID=data-source-org-id
# Public endpoint URL for this data source (used as OAuth2 client_id in Connectathon)
DATA_SOURCE_ENDPOINT=https://data-source.example.com

# PCM Configuration
# PCM introspection mode: "pcm" (real PCM) or "mock" (local demo)
# Use "mock" for local development without PCM infrastructure
PCM_INTROSPECTION_MODE=mock
# Base URL for PCM Core API (provided by PCM Admin or certificate bundle)
# Example Connectathon: https://pcm-connectathon-mtls-xxxxx.elb.il-central-1.amazonaws.com:4501
PCM_BASE_URL=https://pcm-core.example.com:3000
# Token endpoint path for OAuth2 client credentials flow
PCM_TOKEN_ENDPOINT=/token
# Introspection endpoint path for validating opaque tokens
PCM_INTROSPECTION_ENDPOINT=/introspect
# OAuth2 metadata endpoint (optional, for discovery)
PCM_METADATA_ENDPOINT=https://pcm-core.example.com:3002/.well-known/oauth-authorization-server
# OAuth2 Client ID for this data source (typically same as DATA_SOURCE_ENDPOINT)
PCM_CLIENT_ID=https://data-source.example.com
# Client certificate thumbprint (x5t#S256) for CNF validation
PCM_CLIENT_CERT_THUMBPRINT=
# Resource parameter for token request (RFC 8707 - Resource Indicators for OAuth 2.0)
# Typically the base URL of the resource server the adapter will access
# Example: https://fhir.example.com (leave empty if PCM doesn't require it)
PCM_RESOURCE=
# Audience claim for client assertion JWT (typically PCM token endpoint full URL)
PCM_CLIENT_ASSERTION_AUDIENCE=https://pcm-core.example.com:3000/token

# PCM mTLS Certificates (required for all PCM communication)
# Client certificate for mutual TLS authentication with PCM (PEM format)
# Download from PCM Admin certificate bundle or Connectathon bundle
# Local Connectathon example: ./secrets/connectathon/custom/org-connecthon-python-298c5466.crt
PCM_MTLS_CERT_PATH=/path/to/pcm-client-cert.pem
# Private key for the client certificate (PEM format)
# Local Connectathon example: ./secrets/connectathon/custom/org-connecthon-python-298c5466.key
PCM_MTLS_KEY_PATH=/path/to/pcm-client-key.pem
# CA certificate for verifying PCM server certificate (PEM format)
# Download from PCM Admin or extract from certificate bundle (rootCA.crt)
# Local Connectathon example: ./secrets/connectathon/rootCA.crt
PCM_CA_CERT_PATH=/path/to/pcm-ca-cert.pem
# TLS servername override for SNI (Server Name Indication)
# Use when PCM_BASE_URL hostname differs from certificate Subject Alternative Name (SAN)
# Example: if URL uses ELB hostname but cert is for "pcm-core", set PCM_TLS_SERVERNAME=pcm-core
# Leave empty if URL hostname matches certificate SAN (typical for production)
PCM_TLS_SERVERNAME=

# PCM Client Assertion (JWT signing for token acquisition)
# Private key for signing the client_assertion JWT (PEM format)
# In Connectathon, typically the same as PCM_MTLS_KEY_PATH
# Local Connectathon example: ./secrets/connectathon/custom/org-connecthon-python-298c5466.key
PCM_CLIENT_ASSERTION_PRIVATE_KEY_PATH=/path/to/client-assertion-signing-key.pem
# JWT signing algorithm: ES256 (EC P-256) or RS256 (RSA)
# Must match the key type: EC keys require ES256, RSA keys require RS256
# Run `npm run cert:check` to verify key type compatibility
PCM_CLIENT_ASSERTION_ALGORITHM=ES256

# PCM Token Cache (optional, disabled by default)
# Enable caching of adapter's own PCM access token to reduce token endpoint calls
PCM_CLIENT_TOKEN_CACHE_ENABLED=false
# Safety margin in seconds before token expiry to trigger refresh (PCM tokens expire in 30s)
PCM_CLIENT_TOKEN_CACHE_SAFETY_MARGIN_SECONDS=5

# Internal FHIR Server
# FHIR forwarding mode: "http" (real FHIR server) or "mock" (local demo)
# Use "mock" for local development without FHIR infrastructure
FHIR_FORWARDING_MODE=mock
# Base URL for the organization's internal FHIR R4 server
# For mock mode, use: http://mock-fhir.local
FHIR_BASE_URL=http://mock-fhir.local
# Format for patient reference in FHIR queries: "bare" (patient=123) or "full" (patient=Patient/123)
FHIR_PATIENT_REFERENCE_FORMAT=bare
# FHIR identifier system for Israeli national ID (used in _security:not parameter)
FHIR_PATIENT_IDENTIFIER_SYSTEM=http://fhir.health.gov.il/identifier/il-national-id
# Timeout for FHIR requests in milliseconds
FHIR_TIMEOUT_MS=30000

# ID Replacement Service
# ID replacement mode: "http" (real service) or "mock" (local demo)
# Use "mock" for local development without ID replacement infrastructure
ID_REPLACEMENT_MODE=mock
# Base URL for the ID swap service (national ID → local patient ID)
# This service may be organization-specific or shared infrastructure
# For mock mode, use: http://mock-id-replacement.local
ID_REPLACEMENT_BASE_URL=http://mock-id-replacement.local
# Endpoint path for ID resolution API
ID_REPLACEMENT_ENDPOINT=/api/v1/resolve
# Timeout for ID replacement requests in milliseconds
ID_REPLACEMENT_TIMEOUT_MS=5000
# Number of retry attempts for failed ID replacement requests
ID_REPLACEMENT_RETRIES=3
# Backoff delay in seconds between retry attempts
ID_REPLACEMENT_RETRY_BACKOFF_SECONDS=0.5
# Authentication credentials for ID replacement service (format depends on service)
# Example formats: "Bearer <token>", "Basic <base64>", "ApiKey <key>"
ID_REPLACEMENT_AUTH=

# Internal JWT (for FHIR server authentication)
# Issuer claim for internal JWT (typically this adapter's identifier)
JWT_ISSUER=data-source-org-id
# Audience claim for internal JWT (typically internal FHIR server URL)
# For mock mode, use: http://mock-fhir.local
JWT_AUDIENCE=http://mock-fhir.local
# JWT expiry time in seconds (60s recommended for short-lived tokens)
JWT_EXPIRY_SECONDS=60
# JWT signing algorithm: RS256 (RSA keys) or ES256 (EC keys)
# Must match the key type - run `npm run cert:check` to verify
JWT_ALGORITHM=RS256
# Private key for signing internal JWTs (PEM format)
# This is separate from PCM client assertion key and used only for internal FHIR authentication
# For local demo with Connectathon key: ./secrets/connectathon/custom/org-ds-python-demo-295d7710.key
JWT_SIGNING_KEY_PATH=/path/to/internal-jwt-private.pem

# Response Verification (enabled by default)
RESPONSE_VERIFICATION_ENABLED=true
FORBIDDEN_SECURITY_LABEL_SYSTEM=http://fhir.health.gov.il/cs/il-core-main-security-label
FORBIDDEN_SECURITY_LABEL_CODE=V

# Audit (enabled by default)
AUDIT_ENABLED=true
