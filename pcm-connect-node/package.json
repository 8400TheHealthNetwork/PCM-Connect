{
  "name": "pcm-fhir-adapter",
  "version": "0.1.0",
  "description": "PCM/FHIR Data Source Adapter",
  "main": "dist/main.js",
  "scripts": {
    "prebuild": "rm -rf dist tsconfig.tsbuildinfo",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "lint": "eslint \"{src,tests}/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "cert:check": "ts-node -r tsconfig-paths/register src/scripts/check-certificates.ts",
    "pcm:token:check": "ts-node -r tsconfig-paths/register src/scripts/check-pcm-token.ts",
    "pcm:introspect:check": "ts-node -r tsconfig-paths/register src/scripts/check-pcm-introspection.ts",
    "id:resolve:check": "ts-node -r tsconfig-paths/register src/scripts/check-id-replacement.ts",
    "adapter:e2e:check": "ts-node -r tsconfig-paths/register src/scripts/check-adapter-e2e.ts",
    "verify:local": "npm run build && npm test",
    "verify:connectathon": "npm run cert:check && npm run pcm:token:check",
    "verify:mock-flow": "npm run adapter:e2e:check"
  },
  "keywords": [
    "pcm",
    "fhir",
    "healthcare",
    "authorization"
  ],
  "author": "",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-fastify": "^10.3.0",
    "fastify": "^4.26.0",
    "jose": "^5.2.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/testing": "^10.4.22",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
