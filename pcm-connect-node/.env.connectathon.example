# Connectathon Environment Configuration Example
# This file contains example values for the PCM Connectathon environment
# Copy this to .env for local development with the Connectathon certificate bundle
#
# IMPORTANT:
# - This file does NOT contain secrets (keys/certs)
# - Extract the certificate bundle ZIP to ./secrets/connectathon/
# - The real .env file is gitignored and must never be committed
# - Private keys and certificates must remain in the ignored secrets/ directory

# Server
PORT=3009
NODE_ENV=development

# Data Source Identity (from Connectathon bundle.json)
DATA_SOURCE_ID=org-connecthon-python-298c5466
DATA_SOURCE_ENDPOINT=https://connecthon-python.demo

# PCM Configuration (from Connectathon bundle.json)
# PCM introspection mode: "pcm" (real PCM) or "mock" (local demo without PCM)
PCM_INTROSPECTION_MODE=pcm
# Base URL for PCM Core API
PCM_BASE_URL=https://pcm-connectathon-mtls-4c336523aef82051.elb.il-central-1.amazonaws.com:4501
# Token endpoint path
PCM_TOKEN_ENDPOINT=/token
# Introspection endpoint path
PCM_INTROSPECTION_ENDPOINT=/introspect
# OAuth2 metadata endpoint (port 4502 for metadata)
PCM_METADATA_ENDPOINT=https://pcm-connectathon-mtls-4c336523aef82051.elb.il-central-1.amazonaws.com:4502/.well-known/oauth-authorization-server
# OAuth2 Client ID (same as DATA_SOURCE_ENDPOINT in Connectathon)
PCM_CLIENT_ID=https://connecthon-python.demo
# Client certificate thumbprint (x5t#S256) for CNF validation
PCM_CLIENT_CERT_THUMBPRINT=2-mGHGuZkYLdh6YgnoP3-trBcBJbqOGXjobtjI_sRxM
# Resource parameter (RFC 8707) - required by Connectathon PCM
# Typically the resource server base URL (FHIR server or data source endpoint)
PCM_RESOURCE=https://connecthon-python.demo
# Audience claim for client assertion JWT (full token endpoint URL)
PCM_CLIENT_ASSERTION_AUDIENCE=https://pcm-connectathon-mtls-4c336523aef82051.elb.il-central-1.amazonaws.com:4501/token

# PCM mTLS Certificates (local paths after extracting bundle ZIP)
# Extract the certificate bundle to: ./secrets/connectathon/
PCM_MTLS_CERT_PATH=./secrets/connectathon/custom/org-connecthon-python-298c5466.crt
PCM_MTLS_KEY_PATH=./secrets/connectathon/custom/org-connecthon-python-298c5466.key
PCM_CA_CERT_PATH=./secrets/connectathon/rootCA.crt
# TLS servername override: Connectathon PCM certificate is issued for "pcm-core"
# but the URL uses ELB hostname, so SNI must use the certificate SAN
PCM_TLS_SERVERNAME=pcm-core

# PCM Client Assertion (same key as mTLS in Connectathon)
PCM_CLIENT_ASSERTION_PRIVATE_KEY_PATH=./secrets/connectathon/custom/org-connecthon-python-298c5466.key
# Connectathon bundle provides RSA key - use RS256
# Run `npm run cert:check` to verify key type and algorithm compatibility
PCM_CLIENT_ASSERTION_ALGORITHM=RS256

# PCM Token Cache (optional, disabled by default)
PCM_CLIENT_TOKEN_CACHE_ENABLED=false
PCM_CLIENT_TOKEN_CACHE_SAFETY_MARGIN_SECONDS=5

# Internal FHIR Server (placeholder - replace with actual internal FHIR server)
# FHIR forwarding mode: "http" (real FHIR server) or "mock" (local demo)
FHIR_FORWARDING_MODE=mock
# Base URL for internal FHIR server - for mock mode use http://mock-fhir.local
FHIR_BASE_URL=http://mock-fhir.local
FHIR_PATIENT_REFERENCE_FORMAT=bare
FHIR_PATIENT_IDENTIFIER_SYSTEM=http://fhir.health.gov.il/identifier/il-national-id
FHIR_TIMEOUT_MS=30000

# ID Replacement Service (placeholder - use mock for V1)
# ID replacement mode: "http" (real service) or "mock" (local demo)
ID_REPLACEMENT_MODE=mock
# Base URL for ID replacement service - for mock mode use http://mock-id-replacement.local
ID_REPLACEMENT_BASE_URL=http://mock-id-replacement.local
ID_REPLACEMENT_ENDPOINT=/api/v1/resolve
ID_REPLACEMENT_TIMEOUT_MS=5000
ID_REPLACEMENT_RETRIES=3
ID_REPLACEMENT_RETRY_BACKOFF_SECONDS=0.5
ID_REPLACEMENT_AUTH=

# Internal JWT (for FHIR server authentication)
# Use DATA_SOURCE_ID as issuer
JWT_ISSUER=org-connecthon-python-298c5466
# Audience should match FHIR_BASE_URL - for mock mode use http://mock-fhir.local
JWT_AUDIENCE=http://mock-fhir.local
JWT_EXPIRY_SECONDS=60
# Separate key for internal JWT signing (placeholder path)
JWT_SIGNING_KEY_PATH=./secrets/internal-jwt-es256-private.pem
# JWT signing algorithm (RS256 for RSA keys, ES256 for EC keys)
# If using the same key as PCM client assertion, use RS256 for Connectathon
JWT_ALGORITHM=RS256

# Response Verification (enabled by default)
RESPONSE_VERIFICATION_ENABLED=true
FORBIDDEN_SECURITY_LABEL_SYSTEM=http://fhir.health.gov.il/cs/il-core-main-security-label
FORBIDDEN_SECURITY_LABEL_CODE=V

# Audit (enabled by default)
AUDIT_ENABLED=true
