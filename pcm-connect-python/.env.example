# Copy to .env and source it before running.

# --- mTLS to PCM (paths to files in certs/) ---
DS_ADAPTER_PCM_CLIENT_CERT=certs/custom/org-ds-python-demo-295d7710.crt
DS_ADAPTER_PCM_CLIENT_KEY=certs/custom/org-ds-python-demo-295d7710.key
DS_ADAPTER_PCM_CA_CERT=certs/rootCA.crt

# --- OAuth2 client_credentials identity ---
# clientId from bundle.json. Used as iss/sub of the client_assertion JWT.
DS_ADAPTER_CLIENT_ID=https://fhir-connect.dev.idgmc.org/oauth/client

# Override the signed assertion's aud when the PCM transport URL is internal
# HTTP but a service mesh originates TLS to PCM's canonical HTTPS endpoint.
# DS_ADAPTER_PCM_CLIENT_ASSERTION_AUDIENCE=https://pcm.example:4501/token

# MOH production defaults to system/*.crus. Override for the MOH test PCM:
DS_ADAPTER_PCM_TOKEN_SCOPE="consent.read consent.write fhir.read"

# --- Internal JWT signing key (ES256, separate from PCM mTLS key) ---
# Generate once:  openssl ecparam -name prime256v1 -genkey -noout -out certs/jwt-signing.key
DS_ADAPTER_JWT_SIGNING_KEY=certs/jwt-signing.key

# --- Optional toggles for local runs ---
DS_ADAPTER_OTEL_ENABLED=false
DS_ADAPTER_AUDIT_ENABLED=false
